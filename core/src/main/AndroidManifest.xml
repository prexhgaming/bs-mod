<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions for container functionality -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" 
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" 
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" 
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" 
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- No android:name here. The loader app owns the Application class and
         extends RenjanaApplication, so the engine's singletons (database,
         instanceManager, instanceLauncher, Pine init) still come up.
         No android:theme either: a library must not dictate the app's theme, and
         declaring one collides with the loader's Theme.Launcher at merge time
         ("application@theme is also present at [:core]"). Activities below that
         need the engine look set it explicitly. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">
        
        <!-- The engine's own Compose screen. Its code is still referenced, so it
             stays declared, but it is no longer an entry point: the loader
             declares the only LAUNCHER activity in the merged manifest. -->
        <activity
            android:name="com.fesu.renjana.ui.MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.Renjana" />

        <!-- Wrapper Activity for running guest apps. Carries the engine theme
             explicitly: :core no longer sets an application-level theme, and this
             activity previously inherited it. -->
        <activity
            android:name="com.fesu.renjana.core.WrapperActivity"
            android:exported="false"
            android:theme="@style/Theme.Renjana"
            android:configChanges="orientation|screenSize|keyboardHidden|keyboard|screenLayout|smallestScreenSize|uiMode|layoutDirection|fontScale|locale"
            android:launchMode="standard"
            android:process=":container"
            android:taskAffinity=":container" />

        <!-- Stub Activities for isolated guest app instances in dedicated processes (:p0 - :p9) -->
        <activity
            android:name="com.fesu.renjana.core.StubActivity_0"
            android:exported="false"
            android:process=":p0"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_1"
            android:exported="false"
            android:process=":p1"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_2"
            android:exported="false"
            android:process=":p2"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_3"
            android:exported="false"
            android:process=":p3"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_4"
            android:exported="false"
            android:process=":p4"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_5"
            android:exported="false"
            android:process=":p5"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_6"
            android:exported="false"
            android:process=":p6"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_7"
            android:exported="false"
            android:process=":p7"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_8"
            android:exported="false"
            android:process=":p8"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />
        <activity
            android:name="com.fesu.renjana.core.StubActivity_9"
            android:exported="false"
            android:process=":p9"
            android:taskAffinity="com.fesu.renjana.guest"
            android:theme="@style/Theme.Renjana.Stub"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|smallestScreenSize|uiMode|fontScale|locale|layoutDirection|density" />

        <!-- Shortcut trampoline: launched by homescreen pinned shortcuts, immediately forwards to the instance -->
        <activity
            android:name="com.fesu.renjana.core.InstanceLaunchActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Renjana.Transparent" />

        <!-- Deep Link Dispatcher: intercepts http/https/custom-scheme links and routes to correct instance -->
        <activity android:name="com.fesu.renjana.core.DeepLinkDispatcherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
            </intent-filter>
        </activity>

        <!-- Container Service (legacy stub, kept for compatibility) -->
        <service
            android:name="com.fesu.renjana.core.ContainerService"
            android:exported="false"
            android:process=":container" />

        <!-- Instance Lifecycle Service (foreground service for background execution) -->
        <service
            android:name="com.fesu.renjana.core.InstanceLifecycleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Container instance lifecycle management" />
        </service>

        <!-- Quick-switch floating bubble overlay -->
        <service
            android:name="com.fesu.renjana.core.QuickSwitchBubbleService"
            android:exported="false" />

        <!-- FileProvider for sharing crash reports as .txt files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Xposed module metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="Renjana - Android Container for Multi-Instance Apps" />
        <meta-data
            android:name="xposedminversion"
            android:value="93" />
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

    </application>

</manifest>
