<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed on Android 11+ to see whether the target game is installed. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- The cloned game runs inside THIS app's process and uid, so Android applies
         this app's permissions, not the game's. Declared here explicitly even
         though :Bcore also contributes RECORD_AUDIO — a silent dependency on a
         vendored module is exactly how the mic breaks without anyone noticing.
         RECORD_AUDIO is dangerous, so it must also be requested at runtime
         (GameActivity.requestGamePermissions); declaring it alone grants nothing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 13+ gates game notifications behind an explicit grant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MODIFY_AUDIO_SETTINGS arrives from :Bcore (normal permission, auto-granted). -->

    <!-- No storage permission is needed: the in-game menu keeps its config in
         /data/data/<game-pkg>/imgui (internal storage of the cloned game) and
         hooks the game's own sockets, which already hold INTERNET. -->

    <application
        android:name=".app.App"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BlackBox"
        tools:targetApi="n">

        <!-- The only screen: a dedicated launcher for the target game. -->
        <activity
            android:name=".view.game.GameActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
