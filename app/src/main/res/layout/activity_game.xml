<?xml version="1.0" encoding="utf-8"?>
<!--
    Single-game launcher.

    Layer order matters: the wallpaper is drawn first, then a vertical scrim and
    a radial vignette bend the artwork's contrast around the type, and only then
    does the content sit on top. Nothing about the sandbox engine is exposed
    here — the screen is about one game and one action.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_bg"
    tools:context=".view.game.GameActivity">

    <!-- Artwork -->
    <ImageView
        android:id="@+id/hero_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <!-- Contrast wash -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_vignette" />

    <!-- Content -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="18dp">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/wordmark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.24"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/launcher_wordmark"
                    android:textColor="@color/launcher_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/brand_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="0.34"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/launcher_brand_sub"
                    android:textColor="@color/launcher_text_faint"
                    android:textSize="9sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/more_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:contentDescription="@string/menu_more"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="⋮"
                    android:textColor="@color/launcher_text_muted"
                    android:textSize="20sp" />
            </FrameLayout>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hero: one game, front and centre -->
        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:layout_gravity="center_horizontal">

            <View
                android:id="@+id/icon_glow"
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_glow_oval"
                android:alpha="0.5" />

            <!-- Monogram behind the icon: shows while the game artwork loads. -->
            <TextView
                android:id="@+id/icon_monogram"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:includeFontPadding="false"
                android:letterSpacing="0.1"
                android:text="@string/launcher_avatar"
                android:textColor="@color/launcher_text_faint"
                android:textSize="26sp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/game_icon"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:elevation="10dp"
                android:padding="0dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_game_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Launcher.Circle"
                app:strokeColor="@color/launcher_stroke"
                app:strokeWidth="1dp"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <TextView
            android:id="@+id/game_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="14"
            android:textColor="@color/launcher_text"
            android:textSize="34sp"
            tools:text="KNIVES OUT" />

        <TextView
            android:id="@+id/game_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:text="@string/launcher_tagline"
            android:textColor="@color/launcher_text_muted"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.2"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="@color/launcher_pill_neutral_text"
            android:textSize="10sp"
            tools:text="READY TO PLAY" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.85" />

        <!-- Only ever shown when something needs the user's hand. -->
        <LinearLayout
            android:id="@+id/notice_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_notice"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                android:id="@+id/notice_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/launcher_text"
                android:textSize="14sp"
                tools:text="Knives Out not found" />

            <TextView
                android:id="@+id/notice_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/launcher_text_muted"
                android:textSize="12sp"
                tools:text="Install the game from your store and reopen this launcher." />

            <TextView
                android:id="@+id/notice_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/action_select_apk"
                android:textColor="@color/launcher_accent_hot"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/launch_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="@color/launcher_text_faint"
            android:textSize="12sp"
            tools:text="Tap to enter the sandbox" />

        <ProgressBar
            android:id="@+id/preparing_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/launcher_accent_hot"
            android:progressBackgroundTint="@color/launcher_pill_neutral_bg"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Call to action -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <View
                android:id="@+id/cta_glow"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow_oval"
                android:alpha="0.35" />

            <FrameLayout
                android:id="@+id/launch_button"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/bg_cta"
                android:clickable="true"
                android:elevation="12dp"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/launch_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play" />

                    <TextView
                        android:id="@+id/launch_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.2"
                        android:shadowColor="#59000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6"
                        android:text="@string/action_launch"
                        android:textColor="@color/launcher_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:id="@+id/button_shine"
                    android:layout_width="58dp"
                    android:layout_height="match_parent"
                    android:alpha="0"
                    android:background="@drawable/bg_shine" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:textColor="@color/launcher_text_faint"
            android:textSize="9sp"
            tools:text="BLACKBOX ENGINE · v3.0.7r4" />
    </LinearLayout>
</FrameLayout>
