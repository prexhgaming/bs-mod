<?xml version="1.0" encoding="utf-8"?>
<!--
  Crash viewer. Deliberately dependency-free: no ConstraintLayout, no binding,
  no app widgets — it must render even when the reason for the crash was the
  engine or a library failing to initialise.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/crashTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/crash_title"
        android:textColor="@color/launcher_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/crashHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/crash_headline"
        android:textColor="@color/launcher_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/crashSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/crash_hint"
        android:textColor="@color/launcher_text_muted"
        android:textSize="13sp" />

    <!-- Report body: scrollable, monospace, selectable so it can be copied by hand. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_crash_card"
        android:padding="12dp">

        <ScrollView
            android:id="@+id/crashScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/crashLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/launcher_text_muted"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </ScrollView>

        <TextView
            android:id="@+id/crashEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/crash_empty"
            android:textColor="@color/launcher_text_faint"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/crashCopy"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_crash_button"
            android:gravity="center"
            android:text="@string/crash_copy"
            android:textColor="@color/launcher_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crashRestart"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_crash_cta"
            android:gravity="center"
            android:text="@string/crash_restart"
            android:textColor="@color/launcher_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/crashClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="@string/crash_close"
        android:textColor="@color/launcher_text_faint"
        android:textSize="13sp" />
</LinearLayout>
