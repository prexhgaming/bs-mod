<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic wash over the wallpaper: dark at the top for the brand row,
     light through the middle so the artwork breathes, deep black at the bottom
     so the CTA and footer stay legible on any artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="@color/scrim_mid"
        android:centerY="0.45"
        android:endColor="@color/scrim_bottom"
        android:startColor="@color/scrim_top"
        android:type="linear" />
</shape>
