<?xml version="1.0" encoding="utf-8"?>
<!-- Soft accent halo. Sits behind the icon ring and the CTA, its alpha is
     animated to make the interface feel alive without moving any pixels. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:endColor="@android:color/transparent"
        android:gradientRadius="50%p"
        android:startColor="@color/launcher_accent_soft"
        android:type="radial" />
</shape>
