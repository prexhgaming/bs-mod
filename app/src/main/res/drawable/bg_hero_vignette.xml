<?xml version="1.0" encoding="utf-8"?>
<!-- Soft radial vignette: keeps the artwork's centre bright and pushes the
     edges into shadow so the type never fights with the background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:centerX="0.5"
        android:centerY="0.42"
        android:endColor="@color/vignette_edge"
        android:gradientRadius="78%p"
        android:startColor="@android:color/transparent"
        android:type="radial" />
</shape>
