<?xml version="1.0" encoding="utf-8"?>
<!-- Primary call to action: ember gradient pill with a hairline highlight on
     top so it reads as a lit, physical surface against the dark artwork.
     The mask item keeps the ripple clipped to the pill's rounded outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DFFFFFF">

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="0"
                android:centerColor="@color/launcher_accent"
                android:endColor="@color/launcher_accent_deep"
                android:startColor="@color/launcher_accent_hot"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
</ripple>
