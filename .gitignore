# App tooling bookkeeping, not project source.
.polydev/
.base/

# Local scratch scripts
/tmp/
__pycache__/
*.pyc

# The game library is 80 MB and is only needed locally to run find_pyrun.py;
# never commit it (GitHub rejects files over 50 MB).
/libGame.so
*.so.txt

# Uploaded game splits / local APKs (large, not project source)
*.apk
split_config.*.apk
/app/src/main/cpp/SDK

# Game resource archives (reference material, not project source)
*.mpk

# Uploaded reference source archives (read for ideas, not built)
*.zip

# Reference dumps from other tools (huge, read-only material)
levi_sdk_dump.txt
uploads/

# Device logcat captures pasted in for debugging
*_logcat*.txt

# Gradle modules (the root /build rule does not cover nested modules)
/core/build
/loader/build

# Signing material — never commit. CI restores the release keystore from
# SIGNING_KEYSTORE_BASE64 / SIGNING_* GitHub secrets into $RUNNER_TEMP and
# deletes it after the build. Local release builds export the same env vars.
*.jks
*.keystore
keystore.properties
