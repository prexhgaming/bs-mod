<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral glass pill. Tinted at runtime for the ready / preparing / missing
     states, so one drawable covers the whole status vocabulary. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="999dp" />
    <solid android:color="@color/launcher_pill_neutral_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/launcher_stroke" />
</shape>
